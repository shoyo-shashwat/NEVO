# .env.example
# Copy to .env and fill in real values.  Never commit .env to version control.

SECRET_KEY=replace-with-a-long-random-string

# Neon PostgreSQL — copy the connection string from your Neon project dashboard.
# Must include ?sslmode=require for Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Cohere Embed v4 — https://dashboard.cohere.com
COHERE_API_KEY=

# ElevenLabs Scribe v2 — https://elevenlabs.io
ELEVENLABS_API_KEY=
