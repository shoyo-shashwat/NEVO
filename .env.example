# Copy to .env and fill in real values. Never commit .env itself.

SECRET_KEY=replace-with-a-long-random-string

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI providers
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
COHERE_API_KEY=
ELEVENLABS_API_KEY=

# Cookie security — set to true in production (Render), leave false for
# local HTTP development.
FORCE_HTTPS_COOKIES=false

# Rate limiting storage. "memory://" is fine for a single instance; move to
# a Redis URI (redis://...) once running more than one app instance.
RATELIMIT_STORAGE_URI=memory://

# Email — required for password reset and any future email notifications.
# Leave SMTP_HOST empty to run without email; app/services/email_client.py
# will clearly report emails as not-configured rather than fake success.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nevo.gov
SMTP_USE_TLS=true
