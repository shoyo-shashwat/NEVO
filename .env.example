# Copy to .env and fill in. Never commit the real .env (already gitignored).

# Flask
FLASK_APP=wsgi:app
SECRET_KEY=                        # any long random string in dev; a real secret in production

# Database — PostgreSQL with postgis + pgvector extensions enabled
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI providers
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
COHERE_API_KEY=
ELEVENLABS_API_KEY=

# Email delivery (optional) — password reset links and government account
# provisioning credentials. If SMTP_HOST is left unset, no email is sent;
# the triggering flow instead shows the link/credentials directly on-screen
# so nothing silently fails. Any SMTP-compatible provider works (SendGrid,
# Mailgun, Amazon SES, Postmark, a plain mailbox) — see app/services/email_client.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
